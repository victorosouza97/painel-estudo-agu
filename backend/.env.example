# Postgres (Neon / Supabase / Railway free tier funcionam bem)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Porta do backend
PORT=4000

# Origem do frontend em desenvolvimento (Vite)
FRONTEND_ORIGIN="http://localhost:5173"

# Segredo para assinar o cookie de sessão (troque por um valor aleatório)
SESSION_SECRET="troque-por-um-valor-aleatorio-longo"

# Login único do site
APP_USER="victor"
# Gere com: node -e "console.log(require('bcryptjs').hashSync('sua-senha', 10))"
APP_PASSWORD_HASH="$2a$10$..."
